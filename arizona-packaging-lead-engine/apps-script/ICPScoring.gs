function calculateICPScore(data){ data=data||{}; var score=0, evidence=[]; var industry=data.industry||''; var fit=PE.INDUSTRY_SCORES[industry]||0; score += fit*0.35; if(fit)evidence.push('industry='+industry); var emp=String(data.employeeSize||'').toLowerCase(); if(/(^|\D)(2|[3-9]|[1-4][0-9]|50)(\D|$)/.test(emp)||/2-50|1-10|11-50/.test(emp)){score+=20;evidence.push('preferred employee range');} else if(/51-200|51/.test(emp)){score+=12;evidence.push('secondary employee range');} else if(!emp)evidence.push('employee size unknown'); if(isArizona(data.city,data.address)){score+=15;evidence.push('Arizona evidence');} if(data.brandEvidence||data.physicalProducts){score+=15;evidence.push('physical-product/brand evidence');} if(data.packagingOpportunity){score+=10;evidence.push('packaging opportunity');} if(data.pocName){score+=5;evidence.push('decision-maker found');} score=Math.max(0,Math.min(100,Math.round(score))); var category=score>=75?'HIGH_FIT':score>=60?'MEDIUM_FIT':score>=40?'LOW_FIT':'NEEDS_REVIEW'; return {score:score,category:category,explanation:evidence.join('; ')||'Insufficient evidence',evidence:evidence}; }

