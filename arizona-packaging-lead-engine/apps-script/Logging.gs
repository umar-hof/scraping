function writeRunLog_(runId,start,stats,status){var sh=getSpreadsheet_().getSheetByName('Run Logs'); sh.appendRow([runId,new Date(start),now_(),stats.discovered,stats.researched,stats.qualified,stats.pocs,stats.emails,stats.phones,stats.added,stats.duplicates,stats.errors,(Date.now()-start)+' ms',status]);}
function generateDailySummary(){var rows=getProspects_(), today=Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM-dd'), count=0,email=0,phone=0,qualified=0; rows.forEach(function(r){if(r[23]&&Utilities.formatDate(new Date(r[23]),Session.getScriptTimeZone(),'yyyy-MM-dd')===today)count++;if(r[4])email++;if(r[2])phone++;if(Number(r[14])>=60)qualified++;}); getSpreadsheet_().getSheetByName('Daily Summary').appendRow([today,rows.length,count,qualified,email,phone,rows.filter(function(r){return r[19]==='SOURCE_LISTED';}).length,rows.filter(function(r){return r[19]==='PROVIDER_VERIFIED'||r[20]==='PROVIDER_VERIFIED';}).length,'','','','']); return true;}

