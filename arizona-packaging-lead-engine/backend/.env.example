# Copy to .env locally. Do not commit tokens/passwords.
GOOGLE_SPREADSHEET_ID=
EXPECTED_SPREADSHEET_ID=
GOOGLE_SHEETS_ACCESS_TOKEN=

# Supabase project selected from Dashboard > Connect.
SUPABASE_ENVIRONMENT=DISPOSABLE
SUPABASE_PROJECT_REF=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSL_CA_FILE=
# Railway image path when service root is /backend: /app/certs/supabase-ca.crt

# Set only after a dedicated disposable Supabase test has passed.
SUPABASE_DISPOSABLE_VALIDATED_SHA256=

# Comma-separated suppression identifiers (Lead IDs or E.164 phone values) for preview only.
SDR_SUPPRESSIONS=

# Railway worker foundation. Defaults are paused, dry-run, and provider-free.
WORKER_START_ENABLED=false
WORKER_ID=
WORKER_JOB_TYPES=ENRICHMENT,VERIFICATION,SHEET_SYNC,RECONCILIATION,MANUAL_REVIEW
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=300
WORKER_POLL_MS=5000
WORKER_DRY_RUN=true
WORKER_DISCOVERY_ENABLED=false
WORKER_ENRICHMENT_ENABLED=false
WORKER_VERIFICATION_ENABLED=false
WORKER_SHEETS_SYNC_ENABLED=false
DISCOVERY_ENABLED=false
ENRICHMENT_ENABLED=false
VERIFICATION_ENABLED=false
SHEETS_SYNC_ENABLED=false
WORKER_RATE_DISCOVERY_MS=1000
WORKER_RATE_ENRICHMENT_MS=1000
WORKER_RATE_VERIFICATION_MS=1000
WORKER_RATE_SHEET_SYNC_MS=1000

# Provider settings remain disabled until vendor, policy, credentials and cost limits are approved.
VERIFICATION_PROVIDER_ENABLED=false
VERIFICATION_MAX_COST_USD=0
VERIFICATION_COST_PER_CHECK_USD=0
EMAIL_VERIFICATION_API_KEY=
PHONE_VERIFICATION_API_KEY=

# Google Sheets sync is not authorized by these placeholders alone.
SHEETS_SYNC_WRITE_APPROVED=false
SHEETS_WRITE_APPROVED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
